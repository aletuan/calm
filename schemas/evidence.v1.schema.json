{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calm.aletuan.com/schemas/evidence.v1.schema.json",
  "title": "Calm Evidence",
  "type": "object",
  "required": ["id", "kind", "source_tool", "pointer", "lineage"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "type": "string" },
    "source_tool": { "type": "string" },
    "source_tool_version": { "type": ["string", "null"] },
    "pointer": { "type": "string" },
    "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "lineage": {
      "type": "object",
      "required": ["session_id", "provenance", "observed_at", "ingested_at"],
      "properties": {
        "session_id": { "type": "string" },
        "source_record_id": { "type": ["string", "null"] },
        "parser_version": { "type": ["string", "null"] },
        "scope_id": { "type": ["string", "null"] },
        "provenance": { "$ref": "common.v1.schema.json#/$defs/provenance" },
        "observed_at": { "type": "string", "format": "date-time" },
        "ingested_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
